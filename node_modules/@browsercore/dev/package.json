{
    "name": "@browsercore/dev",
    "version": "0.2.0",
    "description": "Shared build, lint, test, and coverage tooling for the @browsercore/* packages.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsercore-dev.git"
    },
    "homepage": "https://github.com/jverneuer/browsercore-dev#readme",
    "bugs": {
        "url": "https://github.com/jverneuer/browsercore-dev/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "import": "./dist/vitest.js"
        },
        "./oxlint": {
            "types": "./dist/oxlint.d.ts",
            "import": "./dist/oxlint.js"
        },
        "./tsconfig.base.json": "./tsconfig.base.json",
        "./tsconfig.build.base.json": "./tsconfig.build.base.json",
        "./CODING_STANDARDS.md": "./CODING_STANDARDS.md"
    },
    "bin": {
        "coverage-md": "./bin/coverage-md.mjs"
    },
    "files": [
        "dist",
        "bin",
        "tsconfig.base.json",
        "tsconfig.build.base.json",
        "CODING_STANDARDS.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "oxlint --type-aware src/",
        "clean": "rm -rf dist coverage",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "peerDependencies": {
        "oxlint": "^1.76.0",
        "vitest": "^4.1.10"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    }
}
